# Copy the values you need into your shell (or a .env loader of your choice).
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DEMO_MODE=1

# Leave DB_ENGINE unset to use SQLite. Set to "mysql" to use the docker-compose MySQL.
DB_ENGINE=mysql
DB_NAME=bookit
DB_USER=bookit
DB_PASSWORD=bookit
DB_HOST=127.0.0.1
DB_PORT=3307
